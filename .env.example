# OpenRouter API Key
# สร้างได้ที่: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# LLM Model (optional, default: anthropic/claude-sonnet-4.5)
# ดูรายการ model ได้ที่: https://openrouter.ai/models
LLM_MODEL=anthropic/claude-sonnet-4.5

# LINE Messaging API
# สร้างได้ที่: https://developers.line.biz/console/ → Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# LINE Group ID
# ได้จากการ invite bot เข้า group แล้วดู webhook event
LINE_GROUP_ID=your_group_id_here
